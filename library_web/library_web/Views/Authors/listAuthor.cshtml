@model library_web.Models.DTO.authorNoIdDTO

<h2 class="mb-3">Thông tin tác giả</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card mb-3 col-md-6">
    <ul class="list-group list-group-flush">
        <li class="list-group-item"><strong>Id:</strong> @ViewBag.Id</li>
        <li class="list-group-item"><strong>Họ tên:</strong> @Model.FullName</li>
    </ul>
</div>

<a class="btn btn-secondary" asp-controller="Authors" asp-action="Index">Quay lại danh sách</a>