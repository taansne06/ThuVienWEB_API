@model IEnumerable<library_web.Models.DTO.BookDTO>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">List all books</h2>
    <a class="btn btn-primary" asp-controller="Books" asp-action="addBook">+ Add new book</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-controller="Books" asp-action="Index" method="GET" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Tìm theo</label>
            <select name="filterOn" id="filterOn" class="form-select">
                <option value="title">Tiêu đề</option>
                <option value="description">Mô tả</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Từ khóa</label>
            <input type="text" name="filterQuery" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Sắp xếp theo</label>
            <select name="sortBy" id="sortBy" class="form-select">
                <option value="title">Tiêu đề</option>
                <option value="rate">Đánh giá</option>
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="isAscending" id="asc" value="True" checked />
                <label class="form-check-label" for="asc">Tăng dần</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="isAscending" id="desc" value="False" />
                <label class="form-check-label" for="desc">Giảm dần</label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Search</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Id code</th>
            <th>Title</th>
            <th>Author</th>
            <th>Publisher</th>
            <th>Rating</th>
            <th>Detail</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@foreach (var i in item.AuthorNames)
                    {
                        @i <br />
                    }</td>
                <td>@item.PublisherName</td>
                <td class="text-warning">
                    @for (var i = 0; i < item.Rate; i++)
                    {
                        <span>★</span>
                    }
                </td>
                <td><a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Books" asp-action="listBook" asp-route-id="@item.Id">Detail</a></td>
                <td><a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="Books" asp-action="editBook" asp-route-id="@item.Id">Edit</a></td>
                <td><a class="btn btn-sm btn-outline-danger" asp-area="" asp-controller="Books" asp-action="delBook" asp-route-id="@item.Id" onclick="return confirm('Bạn có chắc muốn xóa sách này?');">Delete</a></td>
            </tr>
        }
    </tbody>
</table>